# system:
Parse the JSON, compute NPS = (promoters/total - detractors/total) * 100, rounded to 1 decimal.
Promoter = 9–10, Passive = 7–8, Detractor = 0–6.
Keep multilingual comments. Select 3–5 short representatives per group. No PII.

# template:
---
artifact: signal
scope: project
project: buyer_experience
nature: qualitative
id: buyer_experience-sig-nps-{{market}}-{{window_start}}_{{window_end}}
date: {{date:%Y-%m-%d}}
source: nps_survey
summary: "NPS feedback for {{market}} over {{window_start}} → {{window_end}} (multilingual)."
coverage: "{{market}}, {{#if platforms}}{{#each platforms}}{{this}}{{#unless @last}}/{{/unless}}{{/each}}{{else}}all platforms{{/if}}"
tags: [nps, buyer_journey, {{market}}]
confidence: medium
limitations:
  - "Rolling window only; not seasonally adjusted."
  - "Multilingual comments."
pii: false
metrics:
  - name: "NPS"
    value: {{Computed NPS}}
    unit: "index"
    window: "{{window_start}} to {{window_end}}"
  - name: "Responses"
    value: {{Total responses}}
    unit: "responses"
    window: "{{window_start}} to {{window_end}}"
  - name: "Promoters"
    value: {{Promoters count}}
    unit: "responses"
    window: "{{window_start}} to {{window_end}}"
  - name: "Passives"
    value: {{Passives count}}
    unit: "responses"
    window: "{{window_start}} to {{window_end}}"
  - name: "Detractors"
    value: {{Detractors count}}
    unit: "responses"
    window: "{{window_start}} to {{window_end}}"
feedback_examples:
  promoters:
{{#each 3–5 representative promoter comments}}    - "{{this}}"
{{/each}}
  passives:
{{#each 3–5 representative passive comments}}    - "{{this}}"
{{/each}}
  detractors:
{{#each 3–5 representative detractor comments}}    - "{{this}}"
{{/each}}
links:
  from: []
  to: []
---
