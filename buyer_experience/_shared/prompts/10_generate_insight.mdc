# name: generate_insight
# description: Transform selected signals into one evidence-backed insight.
# inputs:
#   - insight_id: string             # e.g., "be-ic-2025-08-004"
#   - type?: string                  # default "opportunity"
#   - signal_ids: array[string]      # filenames (no path), e.g., ["buyer_experience-sig-nps-DACH-2025-07-17_2025-08-16","buyer_experience-sig-company-2025"]
#   - owner?: string
# outputs:
#   - path: Insights/{insight_id}.md
#     type: markdown

# system:
Create a valid **insight** per `_shared/schemas/insight.schema.md`. Use only the provided signals to ground claims.

# retrieval:
Load each signal file from:
- signals/quantitative/<signal_id>.md
- signals/qualitative/<signal_id>.md

# template:
---
artifact: insight
project: buyer_experience
id: {{insight_id}}
date: {{date:%Y-%m-%d}}
type: {{type or "opportunity"}}
owner: {{owner or "TBD"}}
claim: "{{Synthesize a short, falsifiable statement from the signals.}}"
strength: {{Infer "weak"|"medium"|"strong" from number/quality of signals}}
tags: []
segments: []
market: {{Infer common market if clear; else "TBD"}}
buyer_journey_phase: {{Infer if obvious (landing|finding|deciding|buying); else "TBD"}}
evidence:
  signals: [{{#each signal_ids}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}]
behavior:
  observed_actions: [{{Derive behaviors if present; else "TBD"}}]
  frequency: "{{Infer or 'TBD'}}"
  recency: "{{Infer or 'TBD'}}"
  intensity: "{{Infer or 'TBD'}}"
links:
  from: [{{#each signal_ids}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}]
  to: []
---
### Rationale
{{Why this matters for buyer experience; keep 2–3 bullets.}}

### Evidence summary
{{1–3 bullets tying signals to the claim.}}

