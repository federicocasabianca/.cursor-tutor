# name: ingest_signal
# description: Create a signal.md from raw content (quantitative or qualitative).
# inputs:
#   - project_slug: string
#   - nature: string
#   - source: string
#   - id_stub: string
#   - summary: string
#   - raw_content: string
# outputs:
#   - path: projects/{project_slug}/signals/{nature}/{project_slug}-sig-{id_stub}.md
#     type: markdown

# system:
Produce a valid **signal** file conforming to `_shared/schemas/signal.schema.md`. Keep it concise.

# template:
---
artifact: signal
scope: project
project: {{project_slug}}
nature: {{nature}}
id: {{project_slug}}-sig-{{id_stub}}
date: {{date:%Y-%m-%d}}
source: {{source}}
summary: "{{summary}}"
tags: []
links:
  from: []
  to: []
{{#if (eq nature "quantitative")}}
metrics: []
{{/if}}
{{#if (eq nature "qualitative")}}
themes: []
verbatims: []
{{/if}}
---
### Summary
{{summary}}

### Evidence
{{raw_content}}

### Notes
- TBD
