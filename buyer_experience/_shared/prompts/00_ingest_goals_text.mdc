# name: ingest_goals_text
# description: Convert company-level goals/mission/vision text (copy/paste from PDF) into a qualitative signal.md.
# inputs:
#   - period_label: string           # e.g., "2025" or "2025_Q3" or "mission_vision"
#   - source_title: string           # e.g., "Company Goals 2025" or "Company Mission & Vision"
#   - pasted_text: string            # paste extracted text
# outputs:
#   - path: signals/qualitative/buyer_experience-sig-company-{period_label}.md
#     type: markdown

# system:
Summarize pasted text into goals/themes, guardrails, and any explicit KPIs. Keep it factual; no hallucinations. Output per `_shared/schemas/signal.schema.md` with scope=company.

# template:
---
artifact: signal
scope: company
project: buyer_experience
nature: qualitative
id: buyer_experience-sig-company-{{period_label}}
date: {{date:%Y-%m-%d}}
source: company_doc
summary: "{{source_title}} — extracted themes and measures."
coverage: "Company-wide"
tags: [company, goals, {{period_label}}]
confidence: medium
limitations:
  - "Text extracted from PDF; sections may be incomplete."
pii: false
themes:
{{#extract 3–8 key themes from pasted_text}}  - "{{this}}"
{{/extract}}
links:
  from: []
  to: []
---
### Raw Excerpts
{{Include 5–12 of the most relevant bullets/lines from pasted_text verbatim}}

### Explicit/Implied Measures of Success
- {{Derive or copy KPIs if present; else 'TBD'}}

### Guardrails / Constraints
- {{Extract constraints if present; else 'TBD'}}

### Notes
- Source: {{source_title}} (pasted text).
